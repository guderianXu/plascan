@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(_placoordinate_find_all FALSE)
if(NOT placoordinate_FIND_COMPONENTS)
    set(_placoordinate_find_all TRUE)
endif()

if(@PLACOORDINATE_BUILD_GDAL@ AND
   (_placoordinate_find_all OR
    "gdal" IN_LIST placoordinate_FIND_COMPONENTS OR
    "presets" IN_LIST placoordinate_FIND_COMPONENTS))
    find_dependency(GDAL REQUIRED)
endif()
if(@PLACOORDINATE_BUILD_STATE@ AND
   (_placoordinate_find_all OR "state" IN_LIST placoordinate_FIND_COMPONENTS))
    find_dependency(nlohmann_json CONFIG REQUIRED)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/placoordinateTargets.cmake")

set(placoordinate_types_FOUND TRUE)
set(placoordinate_transform_FOUND TRUE)
set(placoordinate_gdal_FOUND @PLACOORDINATE_BUILD_GDAL@)
set(placoordinate_presets_FOUND @PLACOORDINATE_BUILD_PRESETS@)
set(placoordinate_state_FOUND @PLACOORDINATE_BUILD_STATE@)
check_required_components(placoordinate)

unset(_placoordinate_find_all)
