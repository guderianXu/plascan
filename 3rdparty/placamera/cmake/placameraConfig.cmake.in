@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(placoordinate 0.1 CONFIG REQUIRED COMPONENTS types)

include("${CMAKE_CURRENT_LIST_DIR}/placameraTargets.cmake")
set(placamera_core_FOUND TRUE)
set(placamera_state_FOUND FALSE)
set(placamera_reference_FOUND FALSE)
set(placamera_gdal_FOUND FALSE)

if("state" IN_LIST placamera_FIND_COMPONENTS)
    if(@PLACAMERA_CONFIG_HAS_STATE@)
        find_dependency(nlohmann_json CONFIG REQUIRED)
        include("${CMAKE_CURRENT_LIST_DIR}/placameraStateTargets.cmake")
        set(placamera_state_FOUND TRUE)
    endif()
endif()

if("reference" IN_LIST placamera_FIND_COMPONENTS)
    if(@PLACAMERA_CONFIG_HAS_REFERENCE@)
        find_dependency(placoordinate 0.1 CONFIG REQUIRED COMPONENTS transform)
        include("${CMAKE_CURRENT_LIST_DIR}/placameraReferenceTargets.cmake")
        set(placamera_reference_FOUND TRUE)
    endif()
endif()

if("gdal" IN_LIST placamera_FIND_COMPONENTS)
    if(@PLACAMERA_CONFIG_HAS_GDAL@)
        find_dependency(GDAL REQUIRED)
        if(NOT TARGET GDAL::GDAL AND GDAL_FOUND)
            add_library(GDAL::GDAL INTERFACE IMPORTED GLOBAL)
            set(_placamera_gdal_include_dirs "${GDAL_INCLUDE_DIRS}")
            if(NOT _placamera_gdal_include_dirs)
                set(_placamera_gdal_include_dirs "${GDAL_INCLUDE_DIR}")
            endif()
            set_target_properties(GDAL::GDAL PROPERTIES
                INTERFACE_INCLUDE_DIRECTORIES "${_placamera_gdal_include_dirs}"
                INTERFACE_LINK_LIBRARIES "${GDAL_LIBRARIES}"
            )
            unset(_placamera_gdal_include_dirs)
        endif()
        include("${CMAKE_CURRENT_LIST_DIR}/placameraGdalTargets.cmake")
        set(placamera_gdal_FOUND TRUE)
    endif()
endif()

check_required_components(placamera)
