if("@CMAKE_SYSTEM_NAME@" STREQUAL "Windows")
  if(CPACK_GENERATOR STREQUAL "ZIP")
    set(CPACK_PACKAGING_INSTALL_PREFIX "/PlaScan")
    set(CPACK_INCLUDE_TOPLEVEL_DIRECTORY OFF)
    set(CPACK_ARCHIVE_COMPONENT_INSTALL ON)
    set(CPACK_COMPONENTS_GROUPING ALL_COMPONENTS_IN_ONE)
  elseif(CPACK_GENERATOR STREQUAL "INNOSETUP")
    set(CPACK_PACKAGING_INSTALL_PREFIX "/")
    set(CPACK_INNOSETUP_SETUP_Compression "lzma2/ultra64")
    set(CPACK_INNOSETUP_SETUP_CompressionThreads "auto")
    set(CPACK_INNOSETUP_SETUP_LZMANumBlockThreads
      "@PLASCAN_INNO_LZMA_BLOCK_THREADS@")
    set(CPACK_INNOSETUP_SETUP_LZMAUseSeparateProcess "yes")
    set(CPACK_INNOSETUP_SETUP_SolidCompression "yes")
    set(CPACK_INNOSETUP_SETUP_DiskSpanning "yes")
    set(CPACK_INNOSETUP_SETUP_DiskSliceSize "1900000000")
    # Inno Setup defaults SlicesPerDisk to 1. Do not emit the literal "1":
    # CPack's boolean translator would turn it into the invalid value "yes".
    if(DEFINED CPACK_INNOSETUP_SETUP_SlicesPerDisk
        AND NOT CPACK_INNOSETUP_SETUP_SlicesPerDisk STREQUAL "1")
      message(FATAL_ERROR
        "PlaScan INNOSETUP packaging requires SlicesPerDisk=1")
    endif()
    unset(CPACK_INNOSETUP_SETUP_SlicesPerDisk)
    list(APPEND CPACK_POST_BUILD_SCRIPTS
      "@CMAKE_SOURCE_DIR@/cmake/PlaScanCollectInnoSetupPackage.cmake")
  endif()
elseif("@CMAKE_SYSTEM_NAME@" STREQUAL "Linux" AND
       CPACK_GENERATOR STREQUAL "DEB")
  set(CPACK_PACKAGING_INSTALL_PREFIX "/opt/plascan")
  set(PLASCAN_EXPECTED_DEB_PACKAGE_NAME "@CPACK_DEBIAN_PACKAGE_NAME@")
  set(PLASCAN_EXPECTED_DEB_PACKAGE_VERSION "@CPACK_PACKAGE_VERSION@")
  set(PLASCAN_EXPECTED_DEB_PACKAGE_VARIANT "@PLASCAN_DEBIAN_PACKAGE_VARIANT@")
  set(PLASCAN_EXPECTED_DEB_DEPENDS "@CPACK_DEBIAN_PACKAGE_DEPENDS@")
  list(APPEND CPACK_POST_BUILD_SCRIPTS
    "@CMAKE_SOURCE_DIR@/cmake/PlaScanVerifyDebPackage.cmake")
endif()
