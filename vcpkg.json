    },
    "gtest",
    "libzip",
    {
      "name": "opencv",
      "default-features": false,
      "features": [
        "calib3d",
        "contrib",
        "highgui",
        "intrinsics",
        "jpeg",
        "openjpeg",
        "png",
        "thread",
        "tiff"
      ]
    },
    "qtbase",
    "tiff"
  ]
}
