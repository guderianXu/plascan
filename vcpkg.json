{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "plascan",
  "version-string": "1.1.7",
  "builtin-baseline": "3c5d90a305ff00ca841f085a74a7ce74ee777dee",
  "dependencies": [
    "apriltag",
    {
      "name": "gdal",
      "default-features": false,
      "features": [
        "jpeg",
        "openjpeg",
        "png",
        "zstd"
      ]
    },
    "gtest",
    "libzip",
    {
      "name": "lapack",
      "platform": "linux"
    },
    "opencl",
    {
      "name": "opencv",
      "default-features": false,
      "features": [
        "calib3d",
        "contrib",
        "dnn",
        "highgui",
        "intrinsics",
        "jpeg",
        "openjpeg",
        "png",
        "thread",
        "tiff"
      ]
    },
    "openmesh",
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "concurrent",
        "doubleconversion",
        "freetype",
        "gui",
        "harfbuzz",
        "jpeg",
        "network",
        "pcre2",
        "png",
        "testlib",
        "thread",
        "vulkan",
        "widgets"
      ]
    },
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "dbus",
        "fontconfig",
        "openssl",
        "xcb"
      ],
      "platform": "linux"
    },
    "qtshadertools",
    "tiff",
    "vulkan",
    {
      "name": "vulkan-loader",
      "default-features": false,
      "features": [
        "xcb"
      ],
      "platform": "linux"
    }
  ],
  "default-features": [],
  "features": {
    "ceres-cuda": {
      "description": "Enable the optional CUDA-capable Ceres reference backend for BA parity tests.",
      "dependencies": [
        {
          "name": "ceres",
          "default-features": false,
          "features": [
            "cuda"
          ]
        }
      ]
    },
    "ceres-suitesparse": {
      "description": "Enable the optional CPU Ceres reference backend for BA parity tests.",
      "dependencies": [
        {
          "name": "ceres",
          "default-features": false,
          "features": [
            "lapack",
            "suitesparse"
          ]
        }
      ]
    }
  }
}
