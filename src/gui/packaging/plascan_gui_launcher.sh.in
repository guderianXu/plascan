#!/usr/bin/env sh
set -eu

APP_ROOT="/opt/plascan"
APP_BIN="${APP_ROOT}/bin/plascan"

if [ ! -x "${APP_BIN}" ]; then
  echo "plascan not found: ${APP_BIN}" >&2
  exit 1
fi

LIB_DIR="${APP_ROOT}/lib"
PLUGIN_DIR="${APP_ROOT}/plugins"

if [ -n "${LD_LIBRARY_PATH:-}" ]; then
  export LD_LIBRARY_PATH="${LIB_DIR}:${LD_LIBRARY_PATH}"
else
  export LD_LIBRARY_PATH="${LIB_DIR}"
fi

export QT_PLUGIN_PATH="${PLUGIN_DIR}"

if [ -d "${APP_ROOT}/share/gdal" ]; then
  export GDAL_DATA="${APP_ROOT}/share/gdal"
fi
if [ -f "${APP_ROOT}/share/proj/proj.db" ]; then
  export PROJ_DATA="${APP_ROOT}/share/proj"
fi

if [ -n "${XDG_DATA_DIRS:-}" ]; then
  export XDG_DATA_DIRS="${APP_ROOT}/share:${XDG_DATA_DIRS}"
else
  export XDG_DATA_DIRS="${APP_ROOT}/share:/usr/local/share:/usr/share"
fi

exec "${APP_BIN}" "$@"
