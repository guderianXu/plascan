# Auto-generated at configure time. Runs during `cmake --install` / CPack staging.

set(_prefix "${CMAKE_INSTALL_PREFIX}")
string(REGEX REPLACE "/$" "" _prefix "${_prefix}")
set(_physical_prefix "${_prefix}")
if(DEFINED ENV{DESTDIR} AND NOT "$ENV{DESTDIR}" STREQUAL "")
    set(_destdir "$ENV{DESTDIR}")
    string(REGEX REPLACE "/$" "" _destdir "${_destdir}")
    if(_prefix MATCHES "^/")
        set(_physical_prefix "${_destdir}${_prefix}")
    else()
        set(_physical_prefix "${_destdir}/${_prefix}")
    endif()
endif()
string(REGEX REPLACE "/$" "" _physical_prefix "${_physical_prefix}")

set(_app_bin "${_physical_prefix}/bin/plascan_gui.bin")
set(_physical_lib_dir "${_physical_prefix}/lib")
set(_physical_plugin_root "${_physical_prefix}/plugins")
set(_bundle_prefixes "@PLASCAN_LINUX_RUNTIME_PREFIXES@")
set(_runtime_search_dirs
    "${_physical_lib_dir}"
    "@PLASCAN_LINUX_RUNTIME_LIBRARY_DIRS@")
list(REMOVE_DUPLICATES _bundle_prefixes)
list(REMOVE_DUPLICATES _runtime_search_dirs)

message(STATUS "[bundle] logical prefix=${_prefix}")
message(STATUS "[bundle] physical prefix=${_physical_prefix}")
message(STATUS "[bundle] approved runtime prefixes=${_bundle_prefixes}")

if(NOT EXISTS "${_app_bin}")
    message(FATAL_ERROR "[bundle] installed app binary is missing: ${_app_bin}")
endif()
if(NOT _bundle_prefixes)
    message(FATAL_ERROR
        "[bundle] no vcpkg/conda runtime prefix was detected; refusing to create an incomplete package")
endif()

file(MAKE_DIRECTORY "${_physical_lib_dir}")

function(_plascan_is_system_abi_library _path _result_var)
    get_filename_component(_name "${_path}" NAME)
    if(_name MATCHES "^ld-linux.*[.]so" OR
       _name MATCHES "^lib(c|m|pthread|rt|dl|resolv|util|nsl|anl)[.]so([.].*)?$")
        set(${_result_var} TRUE PARENT_SCOPE)
    else()
        set(${_result_var} FALSE PARENT_SCOPE)
    endif()
endfunction()

function(_plascan_is_approved_runtime _path _result_var)
    set(_approved FALSE)
    foreach(_candidate_prefix IN LISTS _bundle_prefixes)
        if(NOT _candidate_prefix)
            continue()
        endif()
        cmake_path(IS_PREFIX _candidate_prefix "${_path}" NORMALIZE _is_under_prefix)
        if(_is_under_prefix)
            set(_approved TRUE)
            break()
        endif()
    endforeach()
    set(${_result_var} ${_approved} PARENT_SCOPE)
endfunction()

function(_plascan_install_runtime_dependency _dependency)
    if(NOT EXISTS "${_dependency}")
        message(FATAL_ERROR "[bundle] resolved dependency disappeared: ${_dependency}")
    endif()

    _plascan_is_system_abi_library("${_dependency}" _is_system_abi)
    if(_is_system_abi)
        return()
    endif()

    _plascan_is_approved_runtime("${_dependency}" _is_approved)
    if(NOT _is_approved)
        message(STATUS "[bundle] system-provided dependency: ${_dependency}")
        return()
    endif()

    file(INSTALL
        DESTINATION "${_physical_lib_dir}"
        TYPE SHARED_LIBRARY
        FOLLOW_SYMLINK_CHAIN
        FILES "${_dependency}")
endfunction()

file(GLOB_RECURSE _installed_plugins
    LIST_DIRECTORIES false
    "${_physical_plugin_root}/*.so"
    "${_physical_plugin_root}/*.so.*")

set(_runtime_dependency_args EXECUTABLES "${_app_bin}")
if(_installed_plugins)
    list(APPEND _runtime_dependency_args LIBRARIES ${_installed_plugins})
endif()

file(GET_RUNTIME_DEPENDENCIES
    ${_runtime_dependency_args}
    DIRECTORIES ${_runtime_search_dirs}
    RESOLVED_DEPENDENCIES_VAR _resolved_dependencies
    UNRESOLVED_DEPENDENCIES_VAR _unresolved_dependencies
    CONFLICTING_DEPENDENCIES_PREFIX _conflicting_dependencies
    PRE_EXCLUDE_REGEXES "api-ms-.*" "ext-ms-.*"
    POST_EXCLUDE_REGEXES ".*/ld-linux-.*" ".*/linux-vdso[.]so.*")

if(_unresolved_dependencies)
    message(FATAL_ERROR
        "[bundle] unresolved runtime dependencies: ${_unresolved_dependencies}")
endif()

foreach(_dependency IN LISTS _resolved_dependencies)
    _plascan_install_runtime_dependency("${_dependency}")
endforeach()

# CMake reports a conflict when the same SONAME exists in both an approved
# vcpkg/Conda prefix and a system directory. The packaged RUNPATH intentionally
# prefers /opt/plascan/lib, so select the single approved candidate. Multiple
# approved candidates remain an error because their ABI cannot be disambiguated.
foreach(_filename IN LISTS _conflicting_dependencies_FILENAMES)
    set(_conflict_var "_conflicting_dependencies_${_filename}")
    set(_approved_conflict_candidates "")
    foreach(_candidate IN LISTS ${_conflict_var})
        _plascan_is_approved_runtime("${_candidate}" _is_approved)
        if(_is_approved)
            list(APPEND _approved_conflict_candidates "${_candidate}")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES _approved_conflict_candidates)
    list(LENGTH _approved_conflict_candidates _approved_candidate_count)

    if(_approved_candidate_count GREATER 1)
        message(FATAL_ERROR
            "[bundle] conflicting approved candidates for ${_filename}: "
            "${_approved_conflict_candidates}")
    elseif(_approved_candidate_count EQUAL 1)
        list(GET _approved_conflict_candidates 0 _approved_candidate)
        message(STATUS
            "[bundle] preferring approved ${_filename}: ${_approved_candidate}")
        _plascan_install_runtime_dependency("${_approved_candidate}")
    else()
        message(STATUS
            "[bundle] leaving system dependency conflict to apt: ${_filename}")
    endif()
endforeach()

list(LENGTH _resolved_dependencies _resolved_count)
list(LENGTH _installed_plugins _plugin_count)
message(STATUS
    "[bundle] runtime bundling finished: dependencies=${_resolved_count}, plugins=${_plugin_count}")
