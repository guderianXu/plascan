include("@CMAKE_SOURCE_DIR@/cmake/PlaScanModelPackaging.cmake")

if("@PLASCAN_VERIFY_BUNDLE_ONNX_MODELS@" STREQUAL "ON")
  plascan_verify_bundled_model(
    LABEL "U2Net v1 ONNX"
    FILE "@PLASCAN_BUNDLED_U2NET_ONNX@"
    EXPECTED_SIZE "@PLASCAN_U2NET_ONNX_SIZE@"
    EXPECTED_SHA256 "@PLASCAN_U2NET_ONNX_SHA256@"
  )

  plascan_verify_bundled_model(
    LABEL "LightGlue SIFT K4096 ONNX"
    FILE "@PLASCAN_BUNDLED_LIGHTGLUE_ONNX@"
    EXPECTED_SIZE "@PLASCAN_LIGHTGLUE_ONNX_SIZE@"
    EXPECTED_SHA256 "@PLASCAN_LIGHTGLUE_ONNX_SHA256@"
  )
endif()

