  </property>
  <layout class="QVBoxLayout" name="mainLayout">
   <property name="spacing">
    <number>8</number>
   </property>
   <item>
    <widget class="QLabel" name="introLabel">
     <property name="styleSheet">
      <string notr="true">color: palette(mid); font-size: 88%;</string>
     </property>
     <property name="text">
      <string>将各视图的深度图按一致性检查合并为统一的密集三维点云。仅保留在多个视图中深度一致的点，以滤除噪声和误匹配。</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="fusionGroup">
     <property name="title">
      <string>融合策略</string>
     </property>
     <layout class="QFormLayout" name="fusionForm">
      <item row="0" column="0">
       <widget class="QLabel" name="fusionMethodLabel">
        <property name="text">
         <string>融合方法:</string>
        </property>
        <property name="buddy">
         <cstring>m_fusionMethodCombo</cstring>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QComboBox" name="m_fusionMethodCombo">
        <property name="toolTip">
         <string>Visibility: 利用多视图一致性过滤后合并，最常用</string>
        </property>
        <item>
         <property name="text">
          <string>基于可见性 (Visibility)</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>TSDF 体积融合</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>简单深度平均</string>
         </property>
        </item>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="depthConsistLabel">
        <property name="text">
         <string>深度一致性阈值:</string>
        </property>
        <property name="buddy">
         <cstring>m_depthConsistSpin</cstring>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QDoubleSpinBox" name="m_depthConsistSpin">
        <property name="toolTip">
         <string>相邻视图深度差异阈值 (像素)。★ 推荐 1.0; 严格时设小值</string>
        </property>
        <property name="decimals">
         <number>2</number>
        </property>
        <property name="minimum">
         <double>0.010000000000000</double>
        </property>
        <property name="maximum">
         <double>50.000000000000000</double>
        </property>
        <property name="value">
         <double>1.000000000000000</double>
        </property>
       </widget>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="minConsistViewLabel">
        <property name="text">
         <string>最少一致视图:</string>
        </property>
        <property name="buddy">
         <cstring>m_minConsistViewSpin</cstring>
        </property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="QSpinBox" name="m_minConsistViewSpin">
        <property name="toolTip">
         <string>至少需要多少个一致视图才保留该点。★ 推荐 3</string>
        </property>
        <property name="minimum">
         <number>2</number>
        </property>
        <property name="maximum">
         <number>20</number>
        </property>
        <property name="value">
         <number>3</number>
