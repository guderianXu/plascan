      </item>
      <item row="3" column="1">
       <widget class="QDoubleSpinBox" name="m_normalConsistSpin">
        <property name="toolTip">
         <string>法向量最大偏差角。★ 推荐 30; 越小筛选越严</string>
        </property>
        <property name="suffix">
         <string> °</string>
        </property>
        <property name="decimals">
         <number>1</number>
        </property>
        <property name="maximum">
         <double>90.000000000000000</double>
        </property>
        <property name="value">
         <double>30.000000000000000</double>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
