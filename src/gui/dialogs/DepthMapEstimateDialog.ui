<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>DepthMapEstimateDialog</class>
 <widget class="QDialog" name="DepthMapEstimateDialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>520</width>
    <height>810</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>深度图估计 (Depth Map Estimation)</string>
  </property>
  <property name="minimumSize">
   <size>
    <width>520</width>
    <height>0</height>
   </size>
  </property>
  <layout class="QVBoxLayout" name="rootLayout">
   <property name="spacing">
    <number>8</number>
   </property>
   <item>
    <widget class="QLabel" name="introLabel">
     <property name="text">
      <string>对每张输入影像，利用 PatchMatch 立体匹配算法与相邻视图计算逐像素深度图。预设档位会自动填充推荐参数；选择&quot;自定义&quot;后可自由调节所有参数。</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="presetGroup">
     <property name="title">
      <string>预设方案</string>
     </property>
     <layout class="QFormLayout" name="presetForm">
      <item row="0" column="0">
       <widget class="QLabel" name="atResultLabel">
        <property name="text">
         <string>AT 结果:</string>
        </property>
        <property name="buddy">
         <cstring>m_atResultCombo</cstring>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QComboBox" name="m_atResultCombo">
        <property name="toolTip">
         <string>选择用于深度估计的 AT 结果（对应稀疏点云来源）。</string>
        </property>
        <item>
         <property name="text">
          <string>最新 AT 结果（推荐）</string>
         </property>
        </item>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="presetLabel">
        <property name="text">
         <string>预设:</string>
        </property>
        <property name="buddy">
         <cstring>m_presetCombo</cstring>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QComboBox" name="m_presetCombo">
        <property name="currentIndex">
         <number>1</number>
        </property>
        <item>
         <property name="text">
          <string>快速</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>标准</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>精细</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>自定义</string>
         </property>
        </item>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="patchMatchGroup">
     <property name="title">
      <string>PatchMatch 参数</string>
     </property>
     <layout class="QFormLayout" name="patchMatchForm">
      <item row="0" column="0">
       <widget class="QLabel" name="resScaleLabel">
        <property name="text">
         <string>分辨率缩放:</string>
        </property>
        <property name="buddy">
         <cstring>m_resScaleSpin</cstring>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QDoubleSpinBox" name="m_resScaleSpin">
        <property name="toolTip">
         <string>分辨率缩放：先把影像按该比例缩小后估计深度。数值越小越快、显存占用越低，但细节会减少；1.0 表示原始分辨率。</string>
        </property>
        <property name="decimals">
         <number>4</number>
        </property>
        <property name="minimum">
         <double>0.062500000000000</double>
        </property>
        <property name="maximum">
         <double>1.000000000000000</double>
        </property>
        <property name="singleStep">
         <double>0.062500000000000</double>
        </property>
        <property name="value">
         <double>0.500000000000000</double>
        </property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="iterationsLabel">
        <property name="text">
         <string>迭代次数:</string>
        </property>
        <property name="buddy">
         <cstring>m_iterationsSpin</cstring>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QSpinBox" name="m_iterationsSpin">
        <property name="toolTip">
         <string>迭代次数：PatchMatch 随机搜索和传播的轮数。增加可提高深度收敛稳定性，尤其适合宽深度范围，但运行时间会增加。</string>
        </property>
        <property name="minimum">
         <number>1</number>
        </property>
        <property name="maximum">
         <number>30</number>
        </property>
        <property name="value">
         <number>6</number>
        </property>
       </widget>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="costFuncLabel">
        <property name="text">
         <string>代价函数:</string>
        </property>
        <property name="buddy">
         <cstring>m_costFuncCombo</cstring>
        </property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="QComboBox" name="m_costFuncCombo">
        <property name="toolTip">
         <string>代价函数说明：AD/灰度绝对差速度快但怕光照变化；SD/平方差会放大大误差；NCC/归一化互相关适合亮度整体变化；Census/局部灰度排序对光照更稳；Ternary Census/三值 Census 对微小噪声更宽容。当前 PatchMatch 深度估计主要使用 NCC/Census/SAD/ZNCC 族选项。</string>
        </property>
        <item>
         <property name="text">
          <string>NCC</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>Census</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>SAD</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>ZNCC</string>
         </property>
        </item>
       </widget>
      </item>
      <item row="3" column="0">
       <widget class="QLabel" name="propagLabel">
        <property name="text">
         <string>传播方式:</string>
        </property>
        <property name="buddy">
         <cstring>m_propagCombo</cstring>
        </property>
       </widget>
      </item>
      <item row="3" column="1">
       <widget class="QComboBox" name="m_propagCombo">
        <property name="toolTip">
         <string>传播模式。棋盘格最适合 GPU 并行</string>
        </property>
        <item>
         <property name="text">
          <string>棋盘格 (Checkerboard)</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>顺序 (Sequential)</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>红黑 (Red-Black)</string>
         </property>
        </item>
       </widget>
      </item>
      <item row="4" column="0">
       <widget class="QLabel" name="patchSizeLabel">
        <property name="text">
         <string>窗口大小:</string>
        </property>
        <property name="buddy">
         <cstring>m_patchSizeSpin</cstring>
        </property>
       </widget>
      </item>
      <item row="4" column="1">
       <widget class="QSpinBox" name="m_patchSizeSpin">
        <property name="toolTip">
         <string>窗口大小：计算代价函数时参与比较的局部邻域尺寸，必须为奇数。增大可降低噪声和弱纹理误匹配，但会抹平边缘和小地形细节。</string>
        </property>
        <property name="minimum">
         <number>3</number>
        </property>
        <property name="maximum">
         <number>31</number>
        </property>
        <property name="singleStep">
         <number>2</number>
        </property>
        <property name="value">
         <number>11</number>
        </property>
       </widget>
      </item>
      <item row="5" column="0">
       <widget class="QLabel" name="minViewsLabel">
        <property name="text">
         <string>最少视图:</string>
        </property>
        <property name="buddy">
         <cstring>m_minViewsSpin</cstring>
        </property>
       </widget>
      </item>
      <item row="5" column="1">
       <widget class="QSpinBox" name="m_minViewsSpin">
        <property name="toolTip">
         <string>最少视图：一个深度点至少需要多少个相邻视图支持才更可信。调大更严格、噪声更少，但可能减少可生成深度的区域。</string>
        </property>
        <property name="minimum">
         <number>2</number>
        </property>
        <property name="maximum">
         <number>20</number>
        </property>
        <property name="value">
         <number>3</number>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="depthRangeGroup">
     <property name="title">
      <string>深度范围与置信度</string>
     </property>
     <layout class="QFormLayout" name="depthRangeForm">
      <item row="0" column="0">
       <widget class="QLabel" name="depthMinLabel">
        <property name="text">
         <string>最小深度:</string>
        </property>
        <property name="buddy">
         <cstring>m_depthMinSpin</cstring>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QDoubleSpinBox" name="m_depthMinSpin">
        <property name="toolTip">
         <string>最小深度：深度搜索范围下限，0 表示根据相机和稀疏结果自动估计。范围过窄会漏解，过宽会变慢并增加误匹配。</string>
        </property>
        <property name="decimals">
         <number>2</number>
        </property>
        <property name="minimum">
         <double>0.000000000000000</double>
        </property>
        <property name="maximum">
         <double>100000.000000000000000</double>
        </property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="depthMaxLabel">
        <property name="text">
         <string>最大深度:</string>
        </property>
        <property name="buddy">
         <cstring>m_depthMaxSpin</cstring>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QDoubleSpinBox" name="m_depthMaxSpin">
        <property name="toolTip">
         <string>最大深度：深度搜索范围上限，0 表示自动估计。应覆盖真实地形深度，过大时 PatchMatch 搜索空间变大、收敛更慢。</string>
        </property>
        <property name="decimals">
         <number>2</number>
        </property>
        <property name="minimum">
         <double>0.000000000000000</double>
        </property>
        <property name="maximum">
         <double>100000.000000000000000</double>
        </property>
       </widget>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="confidenceLabel">
        <property name="text">
         <string>置信度阈值:</string>
        </property>
        <property name="buddy">
         <cstring>m_confidenceSpin</cstring>
        </property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="QDoubleSpinBox" name="m_confidenceSpin">
        <property name="toolTip">
         <string>置信度阈值：低于此值的深度像素会被标记为无效。调高会减少噪声和错误深度，但空洞会增加；调低会保留更多点但风险更高。</string>
        </property>
        <property name="decimals">
         <number>2</number>
        </property>
        <property name="minimum">
         <double>0.000000000000000</double>
        </property>
        <property name="maximum">
         <double>1.000000000000000</double>
        </property>
        <property name="singleStep">
         <double>0.050000000000000</double>
        </property>
        <property name="value">
         <double>0.500000000000000</double>
        </property>
       </widget>
      </item>
      <item row="3" column="0" colspan="2">
       <widget class="QCheckBox" name="m_normalMapCheck">
        <property name="toolTip">
         <string>根据深度图估算法向量图，后续融合和网格重建可用来判断表面方向，但会增加少量计算和输出文件。</string>
        </property>
        <property name="text">
         <string>同时输出法向量图</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
       </widget>
      </item>
     </layout>
   </widget>
  </item>
   <item>
    <widget class="QGroupBox" name="depthPyramidGroup">
     <property name="title">
      <string>三级深度策略</string>
     </property>
     <layout class="QFormLayout" name="depthPyramidForm">
      <item row="0" column="0">
       <widget class="QLabel" name="sceneProfileLabel">
        <property name="text">
         <string>场景类型:</string>
        </property>
        <property name="buddy">
         <cstring>m_sceneProfileCombo</cstring>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QComboBox" name="m_sceneProfileCombo">
        <property name="toolTip">
         <string>自动识别会根据相机轨迹和稀疏点云判断环拍物体或航测地形，并选择对应的三级传播与质量门控参数。</string>
        </property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="depthFilterLabel">
        <property name="text">
         <string>深度过滤:</string>
        </property>
        <property name="buddy">
         <cstring>m_depthFilterCombo</cstring>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QComboBox" name="m_depthFilterCombo">
        <property name="toolTip">
         <string>自动模式按场景选择过滤强度。温和适合环拍物体并保留薄结构；中等适合一般航测；强过滤用于抑制地形噪点，但可能减少边缘细节。</string>
        </property>
       </widget>
      </item>
      <item row="2" column="0" colspan="2">
       <widget class="QCheckBox" name="m_savePyramidLevelsCheck">
        <property name="toolTip">
         <string>保存 Level 3 粗层和 Level 2 中层的原始深度、掩膜与预览，供照片上的分级深度信息显示使用；会增加磁盘占用。</string>
        </property>
        <property name="text">
         <string>保存 Level 2/3 可视化栅格</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="hardwareGroup">
     <property name="title">
      <string>硬件与分块</string>
     </property>
     <layout class="QFormLayout" name="hardwareForm">
      <item row="0" column="0" colspan="2">
       <widget class="QCheckBox" name="m_cudaCheck">
        <property name="toolTip">
         <string>启用 CUDA 后优先使用 GPU 计算深度图。速度通常更快，但显存不足时需要降低分辨率缩放或 Tile 尺寸。</string>
        </property>
        <property name="text">
         <string>启用 CUDA 加速</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="tileWLabel">
        <property name="text">
         <string>Tile 宽度:</string>
        </property>
        <property name="buddy">
         <cstring>m_tileWSpin</cstring>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QSpinBox" name="m_tileWSpin">
        <property name="toolTip">
         <string>Tile 宽度：分块处理的水平像素数。大 Tile 可减少边界开销但更占显存；显存不足时优先调小。</string>
        </property>
        <property name="minimum">
         <number>128</number>
        </property>
        <property name="maximum">
         <number>4096</number>
        </property>
        <property name="singleStep">
         <number>128</number>
        </property>
        <property name="value">
         <number>1024</number>
        </property>
       </widget>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="tileHLabel">
        <property name="text">
         <string>Tile 高度:</string>
        </property>
        <property name="buddy">
         <cstring>m_tileHSpin</cstring>
        </property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="QSpinBox" name="m_tileHSpin">
        <property name="toolTip">
         <string>Tile 高度：分块处理的垂直像素数。与 Tile 宽度共同决定单块显存占用，小显存或高分辨率影像应降低。</string>
        </property>
        <property name="minimum">
         <number>128</number>
        </property>
        <property name="maximum">
         <number>4096</number>
        </property>
        <property name="singleStep">
         <number>128</number>
        </property>
        <property name="value">
         <number>1024</number>
        </property>
       </widget>
      </item>
      <item row="3" column="0">
       <widget class="QLabel" name="threadsLabel">
        <property name="text">
         <string>线程数:</string>
        </property>
        <property name="buddy">
         <cstring>m_threadsSpin</cstring>
        </property>
       </widget>
      </item>
      <item row="3" column="1">
       <widget class="QSpinBox" name="m_threadsSpin">
        <property name="toolTip">
         <string>CPU 线程数：CUDA 关闭或回退到 CPU 路径时生效。通常设为物理核心数附近，过高可能造成线程争用。</string>
        </property>
        <property name="minimum">
         <number>1</number>
        </property>
        <property name="maximum">
         <number>128</number>
        </property>
        <property name="value">
         <number>8</number>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="buttonLayout">
     <item>
      <spacer name="buttonSpacer">
       <property name="orientation">
        <enum>Qt::Horizontal</enum>
       </property>
       <property name="sizeHint" stdset="0">
        <size>
         <width>40</width>
         <height>20</height>
        </size>
       </property>
      </spacer>
     </item>
     <item>
      <widget class="QDialogButtonBox" name="buttonBox">
       <property name="standardButtons">
        <set>QDialogButtonBox::Cancel|QDialogButtonBox::Ok</set>
       </property>
      </widget>
     </item>
    </layout>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
