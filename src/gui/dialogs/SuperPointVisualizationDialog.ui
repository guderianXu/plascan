    <width>500</width>
    <height>640</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>特征点显示设置</string>
  </property>
  <layout class="QVBoxLayout" name="mainLayout">
   <item>
    <widget class="QGroupBox" name="fileGroup">
     <property name="title">
      <string>特征文件</string>
     </property>
     <layout class="QHBoxLayout" name="fileLayout">
      <item>
       <widget class="QLabel" name="suffixLabel">
        <property name="text">
         <string>当前算法:</string>
        </property>
        <property name="buddy">
         <cstring>m_suffixCombo</cstring>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QComboBox" name="m_suffixCombo">
        <property name="toolTip">
         <string>切换显示不同算法提取的特征点文件</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="displayGroup">
     <property name="title">
      <string>显示内容</string>
     </property>
     <layout class="QVBoxLayout" name="displayLayout">
      <item>
       <widget class="QCheckBox" name="m_showPointsChk">
        <property name="toolTip">
         <string>显示关键点中心标记</string>
        </property>
        <property name="text">
         <string>显示特征点</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="m_showScaleChk">
        <property name="toolTip">
         <string>显示关键点的尺度圆圈（基于KeyPoint.size）</string>
        </property>
        <property name="text">
         <string>显示尺度圈</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="m_showOrientationChk">
        <property name="toolTip">
         <string>显示关键点的方向（基于KeyPoint.angle）
SuperPoint默认无方向</string>
        </property>
        <property name="text">
         <string>显示方向箭头</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="m_useFillChk">
        <property name="toolTip">
         <string>使用实心标记（默认空心）</string>
        </property>
        <property name="text">
         <string>实心填充</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="styleGroup">
     <property name="title">
      <string>样式设置</string>
     </property>
     <layout class="QFormLayout" name="styleForm">
      <item row="0" column="0">
       <widget class="QLabel" name="markerShapeLabel">
