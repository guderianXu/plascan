        <property name="buddy">
         <cstring>m_octreeDepthSpin</cstring>
        </property>
       </widget>
      </item>
      <item row="3" column="1">
       <widget class="QSpinBox" name="m_octreeDepthSpin">
        <property name="toolTip">
         <string>Poisson 八叉树深度。★ 推荐 10; 增大提升细节但指数级增加内存</string>
        </property>
        <property name="minimum">
         <number>4</number>
        </property>
        <property name="maximum">
         <number>14</number>
        </property>
        <property name="value">
         <number>10</number>
        </property>
