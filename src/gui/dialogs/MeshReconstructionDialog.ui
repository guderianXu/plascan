        <property name="buddy">
         <cstring>m_outputFormatCombo</cstring>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QComboBox" name="m_outputFormatCombo">
        <property name="toolTip">
         <string>最终模型输出格式。PLY 为默认；OBJ 适合带纹理输出。</string>
