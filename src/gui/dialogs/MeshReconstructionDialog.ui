      </item>
      <item row="0" column="1">
       <widget class="QComboBox" name="m_methodCombo">
        <property name="toolTip">
         <string>Poisson: 全局封闭曲面，适合 watertight 模型; Delaunay: 快速但需后处理; Ball Pivoting: 保留细节但慢</string>
        </property>
        <item>
         <property name="text">
          <string>Poisson Surface</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>Delaunay Triangulation</string>
         </property>
        </item>
        <item>
         <property name="text">
