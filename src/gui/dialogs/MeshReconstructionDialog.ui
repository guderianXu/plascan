      </item>
      <item row="2" column="1">
       <widget class="QComboBox" name="m_qualityProfileCombo">
        <property name="toolTip">
         <string>控制网格重建参数组合：细节优先更清晰，轻量模式更省面数和时间。</string>
        </property>
        <property name="currentIndex">
         <number>1</number>
        </property>
        <item>
         <property name="text">
          <string>细节优先 (清晰度高)</string>
