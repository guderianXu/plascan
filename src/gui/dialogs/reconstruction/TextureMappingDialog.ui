<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>TextureMappingDialog</class>
 <widget class="QDialog" name="TextureMappingDialog">
  <property name="geometry"><rect><x>0</x><y>0</y><width>520</width><height>600</height></rect></property>
  <property name="minimumSize"><size><width>520</width><height>0</height></size></property>
  <property name="windowTitle"><string>生成纹理</string></property>
  <layout class="QVBoxLayout" name="mainLayout">
   <property name="leftMargin"><number>18</number></property>
   <property name="topMargin"><number>18</number></property>
   <property name="rightMargin"><number>18</number></property>
   <property name="bottomMargin"><number>18</number></property>
   <property name="spacing"><number>12</number></property>
   <item>
    <widget class="QGroupBox" name="textureGroup">
     <property name="title"><string>一般</string></property>
     <layout class="QFormLayout" name="textureForm">
      <property name="horizontalSpacing"><number>18</number></property>
      <property name="verticalSpacing"><number>9</number></property>
      <item row="0" column="0"><widget class="QLabel" name="textureTypeLabel"><property name="text"><string>纹理类型:</string></property></widget></item>
      <item row="0" column="1"><widget class="QComboBox" name="m_textureTypeCombo"><item><property name="text"><string>纹理映射</string></property></item></widget></item>
      <item row="1" column="0"><widget class="QLabel" name="sourceLabel"><property name="text"><string>源数据:</string></property></widget></item>
      <item row="1" column="1"><widget class="QComboBox" name="m_sourceCombo"><item><property name="text"><string>图像</string></property></item></widget></item>
      <item row="2" column="0"><widget class="QLabel" name="uvMethodLabel"><property name="text"><string>映射模式:</string></property></widget></item>
      <item row="2" column="1"><widget class="QComboBox" name="m_uvMethodCombo"><property name="enabled"><bool>false</bool></property><property name="toolTip"><string>当前纹理流程会为每个可见网格面自动生成连通投影视图 UV。</string></property><item><property name="text"><string>自动投影（相机 chart）</string></property></item></widget></item>
      <item row="3" column="0"><widget class="QLabel" name="blendLabel"><property name="text"><string>混合模式:</string></property></widget></item>
      <item row="3" column="1"><widget class="QComboBox" name="m_blendCombo"><property name="toolTip"><string>多影像重叠区域的纹理融合策略。</string></property><item><property name="text"><string>自然 (Natural)</string></property></item><item><property name="text"><string>加权平均</string></property></item><item><property name="text"><string>最佳视角优先</string></property></item></widget></item>
      <item row="4" column="0"><widget class="QLabel" name="texSizeLabel"><property name="text"><string>纹理大小:</string></property></widget></item>
       <item row="4" column="1"><widget class="QComboBox" name="m_texSizeCombo"><property name="toolTip"><string>单张纹理图的边长。8192 会显著增加显存和内存需求。</string></property><property name="currentIndex"><number>3</number></property><item><property name="text"><string>1024</string></property></item><item><property name="text"><string>2048</string></property></item><item><property name="text"><string>4096</string></property></item><item><property name="text"><string>8192</string></property></item><item><property name="text"><string>16384</string></property></item></widget></item>
      <item row="5" column="0"><widget class="QLabel" name="imageDownscaleLabel"><property name="text"><string>影像下采样:</string></property></widget></item>
       <item row="5" column="1"><widget class="QComboBox" name="m_imageDownscaleCombo"><property name="currentIndex"><number>1</number></property><property name="toolTip"><string>在纹理候选评估与烘焙前缩小源影像，降低内存占用；相机内参会同步缩放。</string></property><item><property name="text"><string>原始分辨率</string></property></item><item><property name="text"><string>x2（约 1 个纹理页）</string></property></item><item><property name="text"><string>x4</string></property></item></widget></item>
      <item row="6" column="0" colspan="2"><widget class="QCheckBox" name="m_saveEachStepCheck"><property name="enabled"><bool>false</bool></property><property name="toolTip"><string>纹理当前为单步任务，完成后会自动保存结果。</string></property><property name="text"><string>在每个步骤完成后保存项目</string></property></widget></item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="qualityGroup">
     <property name="title"><string>高级</string></property>
     <layout class="QFormLayout" name="qualityForm">
      <property name="horizontalSpacing"><number>18</number></property>
      <property name="verticalSpacing"><number>8</number></property>
       <item row="0" column="0" colspan="2"><widget class="QCheckBox" name="m_holeFillCheck"><property name="toolTip"><string>在纹理空间扩展有效颜色，填充三角面边缘的小孔并降低采样黑边。</string></property><property name="text"><string>启用孔洞填充</string></property><property name="checked"><bool>true</bool></property></widget></item>
       <item row="1" column="0" colspan="2"><widget class="QCheckBox" name="m_ghostFilterCheck"><property name="toolTip"><string>融合多个视角时剔除偏离中值颜色的样本，减少移动物体与错配造成的重影。</string></property><property name="text"><string>启用重影过滤器</string></property><property name="checked"><bool>true</bool></property></widget></item>
       <item row="2" column="0" colspan="2"><widget class="QCheckBox" name="m_outOfFocusFilterCheck"><property name="toolTip"><string>根据影像拉普拉斯清晰度降低或过滤明显失焦视角。</string></property><property name="text"><string>启用焦外影像过滤器</string></property></widget></item>
       <item row="3" column="0" colspan="2"><widget class="QCheckBox" name="m_colorCorrCheck"><property name="toolTip"><string>以有效区域的中位亮度为基准校正各源影像曝光。</string></property><property name="text"><string>自动色彩校正</string></property></widget></item>
      <item row="4" column="0" colspan="2"><widget class="QCheckBox" name="m_useAssignedImagesCheck"><property name="enabled"><bool>false</bool></property><property name="toolTip"><string>当前版本会使用可用的全部已定向影像。</string></property><property name="text"><string>使用指定影像</string></property></widget></item>
      <item row="5" column="0" colspan="2"><widget class="QCheckBox" name="m_transferTextureCheck"><property name="enabled"><bool>false</bool></property><property name="text"><string>转移纹理</string></property></widget></item>
      <item row="6" column="0"><widget class="QLabel" name="paddingLabel"><property name="text"><string>纹理填充边距:</string></property></widget></item>
      <item row="6" column="1"><widget class="QSpinBox" name="m_paddingSpin"><property name="toolTip"><string>纹理图内每个图表外扩的像素数，避免边缘采样出现缝隙。</string></property><property name="minimum"><number>2</number></property><property name="maximum"><number>32</number></property><property name="value"><number>4</number></property></widget></item>
      <item row="7" column="0"><widget class="QLabel" name="seamsMarginLabel"><property name="text"><string>锐化强度:</string></property></widget></item>
       <item row="7" column="1"><widget class="QDoubleSpinBox" name="m_seamsMarginSpin"><property name="toolTip"><string>纹理烘焙后的反遮罩锐化强度；0 表示不锐化。</string></property><property name="decimals"><number>2</number></property><property name="minimum"><double>0.000000000000000</double></property><property name="maximum"><double>2.000000000000000</double></property><property name="singleStep"><double>0.050000000000000</double></property><property name="value"><double>1.000000000000000</double></property></widget></item>
      <item row="8" column="0" colspan="2"><widget class="QCheckBox" name="m_keepUnmappedCheck"><property name="text"><string>保留无纹理区域（以默认色填充）</string></property><property name="checked"><bool>true</bool></property></widget></item>
     </layout>
    </widget>
   </item>
   <item><spacer name="verticalSpacer"><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>12</height></size></property></spacer></item>
   <item>
    <layout class="QHBoxLayout" name="buttonLayout">
     <item><spacer name="buttonSpacer"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
     <item><widget class="QPushButton" name="m_runBtn"><property name="text"><string>确定</string></property></widget></item>
     <item><widget class="QPushButton" name="m_cancelBtn"><property name="text"><string>取消</string></property></widget></item>
    </layout>
   </item>
  </layout>
