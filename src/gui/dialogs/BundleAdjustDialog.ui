      </item>
      <item>
       <widget class="QTableWidget" name="m_resultCameraTable">
        <property name="editTriggers">
         <set>QAbstractItemView::NoEditTriggers</set>
        </property>
        <property name="selectionBehavior">
         <enum>QAbstractItemView::SelectRows</enum>
        </property>
       </widget>
      </item>
      <item>
       <layout class="QHBoxLayout" name="resultButtonLayout">
        <item>
         <widget class="QToolButton" name="m_applyResultBtn">
          <property name="text">
           <string>保留本次平差结果</string>
          </property>
          <property name="toolTip">
           <string>将本次平差后的相机参数写回项目并生效。</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QToolButton" name="m_discardResultBtn">
          <property name="text">
           <string>丢弃本次平差结果</string>
          </property>
          <property name="toolTip">
           <string>放弃当前预览结果，项目相机参数保持不变。</string>
          </property>
         </widget>
        </item>
        <item>
         <spacer name="resultButtonSpacer">
          <property name="orientation">
           <enum>Qt::Horizontal</enum>
          </property>
          <property name="sizeHint" stdset="0">
           <size>
            <width>40</width>
            <height>20</height>
           </size>
          </property>
         </spacer>
        </item>
       </layout>
      </item>
     </layout>
    </widget>
