   </item>
   <item>
    <widget class="QGroupBox" name="ioBox">
     <property name="title">
      <string>输出目录</string>
     </property>
     <layout class="QFormLayout" name="ioForm">
      <item row="0" column="0">
       <widget class="QLabel" name="outputDirLabel">
        <property name="text">
         <string>输出目录</string>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <layout class="QHBoxLayout" name="outputDirLayout">
        <item>
         <widget class="QLineEdit" name="m_outputDirEdit">
          <property name="placeholderText">
           <string>请选择输出目录（将写入 tsai、txt、csv、json）</string>
          </property>
          <property name="toolTip">
           <string>只指定目录，不再指定前缀。
输出内容包括：
1) 平差后 tsai
2) 精度评估 txt/csv
3) 运行摘要 json</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QToolButton" name="chooseOutputBtn">
          <property name="text">
           <string>选择...</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>
     </layout>
    </widget>
   </item>
   <item>
   <widget class="QGroupBox" name="basicGroup">
     <property name="title">
      <string>基础参数（常用）</string>
     </property>
     <layout class="QFormLayout" name="basicForm">
      <item row="0" column="0">
       <widget class="QLabel" name="maxIterationsLabel">
        <property name="text">
         <string>外层迭代</string>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QSpinBox" name="m_maxIterationsSpin">
        <property name="toolTip">
         <string>外层交替优化迭代次数。过大可能增加耗时。</string>
        </property>
        <property name="minimum">
         <number>1</number>
        </property>
        <property name="maximum">
         <number>100</number>
        </property>
        <property name="value">
         <number>12</number>
        </property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="minMatchesLabel">
        <property name="text">
         <string>最小匹配点阈值</string>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QSpinBox" name="m_minMatchesSpin">
        <property name="toolTip">
         <string>少于该匹配点数的影像对将被跳过。</string>
        </property>
        <property name="maximum">
         <number>100000</number>
        </property>
        <property name="value">
         <number>10</number>
        </property>
       </widget>
      </item>
      <item row="2" column="0" colspan="2">
       <widget class="QCheckBox" name="m_refinePoseCheck">
        <property name="toolTip">
         <string>开启后会同时优化相机外参，可提升整体一致性。</string>
        </property>
        <property name="text">
         <string>优化相机位姿（推荐开启）</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="advancedGroup">
     <property name="title">
      <string>高级参数（鲁棒/收敛）</string>
     </property>
     <layout class="QFormLayout" name="advForm">
      <item row="0" column="0">
       <widget class="QLabel" name="maxPointItersLabel">
        <property name="text">
         <string>点优化迭代</string>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QSpinBox" name="m_maxPointItersSpin">
        <property name="toolTip">
         <string>每条空间点轨迹的局部优化迭代上限。</string>
        </property>
        <property name="minimum">
         <number>1</number>
        </property>
        <property name="maximum">
         <number>80</number>
        </property>
        <property name="value">
         <number>8</number>
        </property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="maxCameraItersLabel">
        <property name="text">
         <string>相机优化迭代</string>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QSpinBox" name="m_maxCameraItersSpin">
        <property name="toolTip">
         <string>每台相机位姿优化迭代上限。</string>
        </property>
        <property name="minimum">
         <number>1</number>
        </property>
        <property name="maximum">
         <number>80</number>
        </property>
        <property name="value">
         <number>5</number>
        </property>
       </widget>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="huberDeltaLabel">
        <property name="text">
         <string>Huber δ</string>
        </property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="QDoubleSpinBox" name="m_huberDeltaSpin">
        <property name="toolTip">
         <string>Huber 鲁棒核阈值（像素）。越小越强抑制粗差。</string>
        </property>
        <property name="decimals">
         <number>4</number>
        </property>
        <property name="maximum">
         <double>1000.000000000000000</double>
        </property>
        <property name="value">
         <double>3.000000000000000</double>
        </property>
       </widget>
      </item>
      <item row="3" column="0">
       <widget class="QLabel" name="dampingLabel">
        <property name="text">
         <string>阻尼</string>
        </property>
       </widget>
      </item>
      <item row="3" column="1">
       <widget class="QDoubleSpinBox" name="m_dampingSpin">
        <property name="toolTip">
         <string>LM 阻尼系数，过大可能收敛慢，过小可能不稳定。</string>
        </property>
        <property name="decimals">
         <number>10</number>
        </property>
        <property name="minimum">
         <double>0.000000000001000</double>
        </property>
        <property name="maximum">
         <double>1.000000000000000</double>
        </property>
        <property name="singleStep">
         <double>0.000001000000000</double>
        </property>
        <property name="value">
         <double>0.000001000000000</double>
        </property>
       </widget>
      </item>
      <item row="4" column="0">
       <widget class="QLabel" name="stepTolLabel">
        <property name="text">
         <string>收敛阈值</string>
        </property>
       </widget>
      </item>
      <item row="4" column="1">
       <widget class="QDoubleSpinBox" name="m_stepTolSpin">
        <property name="toolTip">
         <string>参数步长收敛阈值，小于该值视为收敛。</string>
        </property>
        <property name="decimals">
         <number>10</number>
        </property>
        <property name="minimum">
         <double>0.000000000100000</double>
        </property>
        <property name="maximum">
         <double>1.000000000000000</double>
        </property>
        <property name="singleStep">
         <double>0.000001000000000</double>
        </property>
        <property name="value">
         <double>0.000001000000000</double>
        </property>
       </widget>
      </item>
      <item row="5" column="0">
       <widget class="QLabel" name="finiteDiffLabel">
        <property name="text">
         <string>数值微分步长</string>
        </property>
       </widget>
      </item>
      <item row="5" column="1">
       <widget class="QDoubleSpinBox" name="m_finiteDiffSpin">
        <property name="toolTip">
         <string>数值微分步长，用于雅可比近似。</string>
        </property>
        <property name="decimals">
         <number>10</number>
        </property>
        <property name="minimum">
         <double>0.000000010000000</double>
        </property>
        <property name="maximum">
         <double>1.000000000000000</double>
        </property>
        <property name="singleStep">
         <double>0.000100000000000</double>
        </property>
        <property name="value">
         <double>0.000100000000000</double>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="systemGroup">
     <property name="title">
      <string>系统参数（并发/资源）</string>
