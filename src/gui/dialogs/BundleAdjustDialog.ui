      </item>
      <item row="6" column="0" colspan="2">
       <widget class="QCheckBox" name="m_dryRunCheck">
        <property name="toolTip">
         <string>用于检查当前数据是否可运行，不会修改任何结果。</string>
        </property>
        <property name="text">
         <string>Dry Run（仅统计输入，不执行优化）</string>
        </property>
