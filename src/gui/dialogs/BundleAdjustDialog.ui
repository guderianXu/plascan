   </rect>
  </property>
  <property name="windowTitle">
   <string>光束法平差</string>
  </property>
  <layout class="QVBoxLayout" name="rootLayout">
   <item>
    <widget class="QGroupBox" name="imagesBox">
     <property name="title">
      <string>输入影像（勾选参与平差的影像）</string>
