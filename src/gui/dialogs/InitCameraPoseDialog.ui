         </item>
         <item row="1" column="1">
          <widget class="QDoubleSpinBox" name="m_defaultFocalSpin">
           <property name="toolTip">
            <string>当 EXIF 不可用时使用的默认焦距。★ 推荐根据实际镜头填写</string>
           </property>
           <property name="suffix">
            <string> mm</string>
           </property>
           <property name="decimals">
            <number>1</number>
           </property>
           <property name="minimum">
            <double>1.000000000000000</double>
           </property>
           <property name="maximum">
            <double>10000.000000000000000</double>
           </property>
           <property name="value">
            <double>50.000000000000000</double>
