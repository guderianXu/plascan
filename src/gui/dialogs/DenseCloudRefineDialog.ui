<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>DenseCloudRefineDialog</class>
 <widget class="QDialog" name="DenseCloudRefineDialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>480</width>
    <height>620</height>
   </rect>
  </property>
  <property name="minimumSize">
   <size>
    <width>480</width>
    <height>0</height>
   </size>
  </property>
  <property name="windowTitle">
   <string>密集点云后处理</string>
  </property>
  <layout class="QVBoxLayout" name="mainLayout">
   <property name="spacing">
    <number>8</number>
   </property>
   <item>
    <widget class="QLabel" name="infoLabel">
     <property name="styleSheet">
      <string notr="true">color: palette(mid); font-size: 88%;</string>
     </property>
     <property name="text">
      <string>对密集点云依次执行离群点滤除、体素精简、法向量估计和颜色校正。勾选对应步骤的标题栏以启用，未勾选的步骤将被跳过。</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="m_sorGroup">
     <property name="toolTip">
      <string>移除偏离邻域均值超过 N 倍标准差的点。可有效清除孤立噪声点。</string>
     </property>
     <property name="title">
      <string>1. 统计离群点移除 (SOR)（勾选后启用）</string>
     </property>
     <property name="checkable">
      <bool>true</bool>
     </property>
     <property name="checked">
      <bool>true</bool>
     </property>
     <layout class="QFormLayout" name="sorForm">
      <item row="0" column="0">
       <widget class="QLabel" name="sorKLabel">
        <property name="text">
         <string>邻居数 (K):</string>
        </property>
        <property name="buddy">
         <cstring>m_sorKSpin</cstring>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QSpinBox" name="m_sorKSpin">
        <property name="toolTip">
         <string>统计时使用的 KNN 邻居数。★ 推荐 30；密集点云可适当增大至 50</string>
        </property>
        <property name="minimum">
         <number>2</number>
        </property>
        <property name="maximum">
         <number>200</number>
        </property>
        <property name="value">
         <number>30</number>
        </property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="sorStdLabel">
        <property name="text">
         <string>标准差倍数:</string>
        </property>
        <property name="buddy">
         <cstring>m_sorStdSpin</cstring>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QDoubleSpinBox" name="m_sorStdSpin">
        <property name="toolTip">
         <string>距离超过均值 + N×σ 的点被判为离群点。★ 推荐 2.0；减小可更激进地去噪，增大则更保守</string>
        </property>
        <property name="decimals">
         <number>1</number>
        </property>
        <property name="minimum">
         <double>0.100000000000000</double>
        </property>
        <property name="maximum">
         <double>10.000000000000000</double>
        </property>
        <property name="singleStep">
         <double>0.500000000000000</double>
        </property>
        <property name="value">
         <double>2.000000000000000</double>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="m_voxelGroup">
     <property name="toolTip">
      <string>将空间划分为固定大小体素，每个体素内只保留质心点，降低点云密度。</string>
     </property>
     <property name="title">
      <string>2. 体素下采样（勾选后启用）</string>
     </property>
     <property name="checkable">
      <bool>true</bool>
     </property>
     <property name="checked">
      <bool>false</bool>
     </property>
     <layout class="QFormLayout" name="voxelForm">
      <item row="0" column="0">
       <widget class="QLabel" name="voxelSizeLabel">
        <property name="text">
         <string>体素大小 (m):</string>
        </property>
        <property name="buddy">
         <cstring>m_voxelSizeSpin</cstring>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QDoubleSpinBox" name="m_voxelSizeSpin">
        <property name="toolTip">
         <string>体素边长（米）。值越大采样越稀疏；典型值 0.005 m（5 mm）</string>
        </property>
        <property name="decimals">
         <number>4</number>
        </property>
        <property name="minimum">
         <double>0.001000000000000</double>
        </property>
        <property name="maximum">
         <double>100.000000000000000</double>
        </property>
        <property name="singleStep">
         <double>0.001000000000000</double>
        </property>
        <property name="value">
         <double>0.005000000000000</double>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="m_normalGroup">
     <property name="toolTip">
      <string>利用局部邻域 PCA 重新估计每个点的法向量，供网格重建使用。</string>
     </property>
     <property name="title">
      <string>3. 法向量估计（勾选后启用）</string>
     </property>
     <property name="checkable">
      <bool>true</bool>
     </property>
     <property name="checked">
      <bool>true</bool>
     </property>
     <layout class="QFormLayout" name="normalForm">
      <item row="0" column="0">
       <widget class="QLabel" name="normalKLabel">
        <property name="text">
         <string>邻域 K:</string>
        </property>
        <property name="buddy">
         <cstring>m_normalKSpin</cstring>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QSpinBox" name="m_normalKSpin">
        <property name="toolTip">
         <string>法向量估计时的邻域点数。★ 推荐 30；细节丰富的场景可适当减小</string>
        </property>
        <property name="minimum">
         <number>5</number>
        </property>
        <property name="maximum">
         <number>200</number>
        </property>
        <property name="value">
         <number>30</number>
        </property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="smoothIterLabel">
        <property name="text">
         <string>平滑迭代:</string>
        </property>
        <property name="buddy">
         <cstring>m_smoothIterSpin</cstring>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QSpinBox" name="m_smoothIterSpin">
        <property name="toolTip">
         <string>法向量平滑迭代次数，可减少法向量噪声。0 = 不平滑；★ 推荐 2</string>
        </property>
        <property name="maximum">
         <number>20</number>
        </property>
        <property name="value">
         <number>2</number>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="m_colorGroup">
     <property name="toolTip">
      <string>对多视图颜色进行全局一致性校正，减少因光照差异导致的色彩拼接痕迹。</string>
     </property>
     <property name="title">
      <string>4. 颜色校正（勾选后启用）</string>
     </property>
     <property name="checkable">
      <bool>true</bool>
     </property>
     <property name="checked">
      <bool>false</bool>
     </property>
     <layout class="QFormLayout" name="colorForm">
      <item row="0" column="0">
       <widget class="QLabel" name="colorMethodLabel">
        <property name="text">
         <string>校正方法:</string>
        </property>
        <property name="buddy">
         <cstring>m_colorMethodCombo</cstring>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QComboBox" name="m_colorMethodCombo">
        <property name="toolTip">
         <string>直方图均衡：整体亮度均衡，速度最快；增益补偿：逐图像调整增益，适合光照差异大的场景；多频段混合：最自然的过渡，但最慢</string>
        </property>
        <item>
         <property name="text">
          <string>全局直方图均衡</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>增益补偿</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>多频段混合</string>
         </property>
        </item>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="systemGroup">
     <property name="title">
      <string>系统</string>
     </property>
     <layout class="QFormLayout" name="systemForm">
      <item row="0" column="0">
       <widget class="QLabel" name="threadsLabel">
        <property name="text">
         <string>线程数:</string>
        </property>
        <property name="buddy">
         <cstring>m_threadsSpin</cstring>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QSpinBox" name="m_threadsSpin">
        <property name="toolTip">
         <string>CPU 并行线程数。建议设为物理核心数</string>
        </property>
        <property name="minimum">
         <number>1</number>
        </property>
        <property name="maximum">
         <number>128</number>
        </property>
        <property name="value">
         <number>8</number>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="buttonLayout">
     <item>
      <spacer name="buttonSpacer">
       <property name="orientation">
        <enum>Qt::Horizontal</enum>
       </property>
       <property name="sizeHint" stdset="0">
        <size>
         <width>40</width>
         <height>20</height>
        </size>
       </property>
      </spacer>
     </item>
     <item>
      <widget class="QPushButton" name="m_runBtn">
       <property name="text">
        <string>运行后处理</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="m_cancelBtn">
       <property name="text">
        <string>取消</string>
       </property>
      </widget>
     </item>
    </layout>
   </item>
  </layout>
 </widget>
