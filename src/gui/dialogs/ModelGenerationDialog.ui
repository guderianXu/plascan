        </property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="QSpinBox" name="m_meshResSpin">
        <property name="toolTip">
         <string>隐式场分辨率（最长轴体素数）。越高细节越多，耗时越长。</string>
        </property>
        <property name="minimum">
         <number>64</number>
        </property>
        <property name="maximum">
         <number>1024</number>
        </property>
        <property name="singleStep">
         <number>32</number>
