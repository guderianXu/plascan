   <item>
    <widget class="QGroupBox" name="advancedGroup">
     <property name="title">
      <string>重建参数（可与预设独立调整）</string>
     </property>
     <layout class="QFormLayout" name="advancedForm">
      <item row="0" column="0">
       <widget class="QLabel" name="disparityLabel">
        <property name="text">
         <string>视差范围：</string>
        </property>
        <property name="buddy">
         <cstring>m_disparitySpin</cstring>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QSpinBox" name="m_disparitySpin">
        <property name="toolTip">
         <string>SGBM 视差搜索范围，必须为 16 的倍数。越大越慢但覆盖更深的景深差异。</string>
        </property>
        <property name="minimum">
         <number>16</number>
        </property>
        <property name="maximum">
         <number>512</number>
        </property>
        <property name="singleStep">
         <number>16</number>
        </property>
