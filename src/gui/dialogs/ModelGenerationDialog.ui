      </item>
      <item row="3" column="1">
       <widget class="QSpinBox" name="m_meshSmoothIterSpin">
        <property name="toolTip">
         <string>Taubin 平滑迭代次数。0 表示不平滑。</string>
        </property>
        <property name="maximum">
         <number>10</number>
        </property>
       </widget>
      </item>
      <item row="4" column="0">
       <widget class="QLabel" name="meshSmoothLambdaLabel">
        <property name="text">
