# PlaScan 构建环境 — Ubuntu 24.04 + LibTorch + Qt6 + OpenCV + GDAL
# 用法: docker build -t plascan-build -f docker/Dockerfile.ubuntu2404 .

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

# ── 系统依赖 ──
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake ninja-build g++ \
    git curl wget ca-certificates \
    qt6-base-dev qt6-base-dev-tools qt6-tools-dev qt6-tools-dev-tools \
    libopencv-dev \
    libgdal-dev \
    libtiff-dev \
    libzip-dev zipcmp zipmerge ziptool \
    nvidia-cuda-dev \
    libgtest-dev \
    libomp-dev \
    unzip \
    pkg-config \
    python3 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# ── LibTorch (CPU, 2.6.0) ──
# CUDA 版本可通过环境变量或挂载覆盖
RUN wget -q https://download.pytorch.org/libtorch/cpu/libtorch-cxx11-abi-shared-with-deps-2.6.0%2Bcpu.zip \
    -O /tmp/libtorch.zip && \
    unzip -q /tmp/libtorch.zip -d /opt && \
    rm /tmp/libtorch.zip && \
    # CPU LibTorch 缺少 CUDA cmake 宏文件, 创建空 stub
    mkdir -p /opt/libtorch/include/c10/cuda/impl && \
    touch /opt/libtorch/include/c10/cuda/impl/cuda_cmake_macros.h
ENV Torch_DIR=/opt/libtorch/share/cmake/Torch

# ── CLI11 (header-only) ──
RUN mkdir -p /usr/local/include/CLI && \
    wget -q https://github.com/CLIUtils/CLI11/releases/download/v2.4.2/CLI11.hpp \
    -O /usr/local/include/CLI/CLI11.hpp

# ── 编译 Google Test (apt 只提供源码) ──
RUN cd /usr/src/googletest && cmake . && make -j$(nproc) && \
    cp lib/libgtest*.a /usr/lib/x86_64-linux-gnu/ && \
    mkdir -p /usr/local/include && \
    cp -r /usr/include/gtest /usr/local/include/ 2>/dev/null || true

# ── 工作目录 ──
WORKDIR /src
VOLUME ["/src"]
