# PlaScan 构建环境 — Ubuntu 24.04 + CUDA 12.4 + LibTorch + Qt6 + OpenCV
#
# 构建: docker build -t plascan-build -f docker/Dockerfile.ubuntu2404 .
# 运行: docker run --rm --gpus all -v $(pwd):/src plascan-build <cmd>
# 开发: ./docker/shell.sh

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

# ── 1. 系统包 (无 CUDA, 先装基础依赖) ──
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake ninja-build g++ \
    git curl wget ca-certificates software-properties-common \
    qt6-base-dev qt6-base-dev-tools qt6-tools-dev qt6-tools-dev-tools \
    libopencv-dev \
    libgdal-dev \
    libtiff-dev \
    libzip-dev zipcmp zipmerge ziptool \
    libgtest-dev \
    libomp-dev \
    unzip \
    libnvidia-gl-580 \
    libnvidia-egl-wayland1 \
    pkg-config \
    python3 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# ── 2. CUDA Toolkit 12.5 (NVIDIA 官方仓库, 包含 nvcc) ──
RUN wget -q https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/x86_64/cuda-keyring_1.1-1_all.deb \
    -O /tmp/cuda-keyring.deb && \
    dpkg -i /tmp/cuda-keyring.deb && rm /tmp/cuda-keyring.deb && \
    apt-get update && apt-get install -y --no-install-recommends \
    cuda-toolkit-12-5 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
ENV CUDA_HOME=/usr/local/cuda-12.5
ENV PATH=${CUDA_HOME}/bin:${PATH}
ENV CMAKE_CUDA_COMPILER=${CUDA_HOME}/bin/nvcc

# ── 3. LibTorch 2.6.0 (CUDA 12.4) ──
RUN wget -q https://download.pytorch.org/libtorch/cu124/libtorch-cxx11-abi-shared-with-deps-2.6.0%2Bcu124.zip \
    -O /tmp/libtorch.zip && \
    unzip -q /tmp/libtorch.zip -d /opt && \
    rm /tmp/libtorch.zip
ENV Torch_DIR=/opt/libtorch/share/cmake/Torch

# ── 4. CLI11 (header-only) ──
RUN mkdir -p /usr/local/include/CLI && \
    wget -q https://github.com/CLIUtils/CLI11/releases/download/v2.4.2/CLI11.hpp \
    -O /usr/local/include/CLI/CLI11.hpp

# ── 5. Google Test (apt 只提供源码, 自行编译) ──
RUN cd /usr/src/googletest && cmake . && make -j$(nproc) && \
    cp lib/libgtest*.a /usr/lib/x86_64-linux-gnu/ && \
    mkdir -p /usr/local/include && \
    cp -r /usr/include/gtest /usr/local/include/ 2>/dev/null || true

# ── 6. 工作目录 ──
WORKDIR /src
VOLUME ["/src"]
