# PlaScan 构建环境 — Ubuntu 24.04 + CUDA 12.5 + LibTorch + Qt6 + OpenGL
#
# 构建: docker build -t plascan-build -f docker/Dockerfile.ubuntu2404 .
# CLI:  ./docker/run.sh feature_extract_cli ...
# GUI:  ./docker/run.sh gui

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

# ── 1. 系统依赖 ──
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake ninja-build g++ \
    git curl wget ca-certificates software-properties-common \
    qt6-base-dev qt6-base-dev-tools qt6-tools-dev qt6-tools-dev-tools \
    libopencv-dev libgdal-dev libtiff-dev libzip-dev zipcmp zipmerge ziptool \
    libgtest-dev libomp-dev unzip pkg-config python3 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# ── 1b. NVIDIA GL 库 (必须精确匹配宿主驱动版本, 当前: 580.126.09) ──
# 版本不匹配会导致 NV-GLX BadValue / QRhiGles2 context 失败
RUN apt-get update && apt-get install -y --no-install-recommends \
    libnvidia-gl-580=580.126.09-0ubuntu0.24.04.2 \
    libnvidia-egl-wayland1 \
    && apt-mark hold libnvidia-gl-580 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# ── 2. CUDA Toolkit 12.5 (NVIDIA 官方, 包含 nvcc) ──
RUN wget -q https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/x86_64/cuda-keyring_1.1-1_all.deb \
    -O /tmp/cuda-keyring.deb && \
    dpkg -i /tmp/cuda-keyring.deb && rm /tmp/cuda-keyring.deb && \
    apt-get update && apt-get install -y --no-install-recommends cuda-toolkit-12-5 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
ENV CUDA_HOME=/usr/local/cuda-12.5
ENV PATH=${CUDA_HOME}/bin:${PATH}
ENV CMAKE_CUDA_COMPILER=${CUDA_HOME}/bin/nvcc

# ── 3. LibTorch 2.6.0 (CUDA 12.4, 兼容 CUDA 12.5 运行时) ──
RUN wget -q https://download.pytorch.org/libtorch/cu124/libtorch-cxx11-abi-shared-with-deps-2.6.0%2Bcu124.zip \
    -O /tmp/libtorch.zip && unzip -q /tmp/libtorch.zip -d /opt && rm /tmp/libtorch.zip
ENV Torch_DIR=/opt/libtorch/share/cmake/Torch

# ── 4. CLI11 (header-only) ──
RUN mkdir -p /usr/local/include/CLI && \
    wget -q https://github.com/CLIUtils/CLI11/releases/download/v2.4.2/CLI11.hpp \
    -O /usr/local/include/CLI/CLI11.hpp

# ── 5. Google Test ──
RUN cd /usr/src/googletest && cmake . && make -j$(nproc) && \
    cp lib/libgtest*.a /usr/lib/x86_64-linux-gnu/ && \
    mkdir -p /usr/local/include && cp -r /usr/include/gtest /usr/local/include/ 2>/dev/null || true

# ── 6. 工作目录 ──
WORKDIR /src
VOLUME ["/src"]
