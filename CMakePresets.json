{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vcpkg-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "BUILD_TESTS": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "PLASCAN_BUNDLE_RUNTIME": "ON"
      }
    },
    {
      "name": "source-deps-base",
      "hidden": true,
      "inherits": "vcpkg-base",
      "cacheVariables": {
        "BUILD_TESTS": "OFF",
        "PLASCAN_BUNDLE_RUNTIME": "OFF",
        "PLASCAN_SOURCE_DEPENDENCIES_ONLY": "ON",
        "VCPKG_MANIFEST_DIR": "${sourceDir}/cmake/source-deps"
      }
    },
    {
      "name": "linux-vcpkg-debug",
      "displayName": "Linux vcpkg Debug",
      "inherits": "vcpkg-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CPACK_GENERATOR": "TGZ;DEB",
        "PLASCAN_BUNDLE_RUNTIME": "OFF",
        "VCPKG_TARGET_TRIPLET": "x64-linux-dynamic",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/cmake/vcpkg-overlays"
      }
    },
    {
      "name": "linux-vcpkg-release",
      "displayName": "Linux vcpkg Release",
      "inherits": "vcpkg-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CPACK_GENERATOR": "TGZ;DEB",
        "PLASCAN_BUNDLE_RUNTIME": "OFF",
        "VCPKG_TARGET_TRIPLET": "x64-linux-dynamic",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/cmake/vcpkg-overlays"
      }
    },
    {
      "name": "linux-source-deps-release",
      "displayName": "Linux Qt 6.11.2 + OpenCV 5.0.0 + GDAL 3.12.4 source dependencies",
      "inherits": "source-deps-base",
      "binaryDir": "${sourceDir}/build/linux-source-deps-release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PLASCAN_SOURCE_DEPENDENCY_PREFIX": "${sourceDir}/build/linux-source-deps-release/install",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/linux-source-deps-release/vcpkg_installed",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/cmake/vcpkg-overlays",
        "VCPKG_TARGET_TRIPLET": "x64-linux-dynamic"
      }
    },
    {
      "name": "linux-source-release",
      "displayName": "Linux Release with source-built Qt/OpenCV/GDAL",
      "inherits": "linux-vcpkg-release",
      "binaryDir": "${sourceDir}/build/linux-source-release",
      "environment": {
        "PROJ_DATA": "${sourceDir}/build/linux-source-deps-release/vcpkg_installed/x64-linux-dynamic/share/proj"
      },
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "${sourceDir}/build/linux-source-deps-release/install",
        "PLASCAN_ENABLE_CUDA": "ON",
        "PLASCAN_ENABLE_TENSORRT": "ON",
        "PLASCAN_REQUIRE_SOURCE_DEPENDENCIES": "ON",
        "PLASCAN_SOURCE_DEPENDENCY_PREFIX": "${sourceDir}/build/linux-source-deps-release/install",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/linux-source-deps-release/vcpkg_installed",
        "VCPKG_MANIFEST_DIR": "${sourceDir}/cmake/source-deps"
      }
    },
    {
      "name": "linux-vcpkg-cuda-opencl-release",
      "displayName": "Linux vcpkg CUDA 13.1 + OpenCL Release",
      "description": "Builds the local Ubuntu CUDA 13.1 developer configuration with native CUDA and NVIDIA OpenCL",
      "inherits": "linux-vcpkg-release",
      "binaryDir": "${sourceDir}/build/linux-vcpkg-cuda-opencl-release",
      "environment": {
        "CUDACXX": "/usr/local/cuda-13.1/bin/nvcc",
        "CUDAHOSTCXX": "/usr/bin/g++-13"
      },
      "cacheVariables": {
        "CMAKE_CUDA_COMPILER": "/usr/local/cuda-13.1/bin/nvcc",
        "CMAKE_CUDA_HOST_COMPILER": "/usr/bin/g++-13",
        "CUDAToolkit_ROOT": "/usr/local/cuda-13.1",
        "PLASCAN_CUDA_ARCHITECTURES": "89",
        "PLASCAN_ENABLE_CUDA": "ON",
        "PLASCAN_ENABLE_OPENCL": "ON",
        "PLASCAN_ENABLE_TENSORRT": "OFF",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/linux-vcpkg-cuda-opencl-release/vcpkg_installed"
      }
    },
    {
      "name": "linux-vcpkg-package-release",
      "displayName": "Linux portable DEB Release Packaging",
      "description": "Builds the Ubuntu 24.04 x86_64 CPU/OpenCL package with bundled vcpkg runtime libraries",
      "inherits": "linux-vcpkg-release",
      "binaryDir": "${sourceDir}/build/linux-vcpkg-package-release",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "/opt/plascan",
        "CPACK_GENERATOR": "DEB",
        "PLASCAN_BUNDLE_BIREFNET_DYNAMIC": "OFF",
        "PLASCAN_BUNDLE_ONNX_MODELS": "ON",
        "PLASCAN_BUNDLE_RUNTIME": "ON",
        "PLASCAN_ENABLE_CUDA": "OFF",
        "PLASCAN_ENABLE_OPENCL": "ON",
        "PLASCAN_ENABLE_TENSORRT": "OFF",
        "PLASCAN_LINUX_REQUIRE_XCB_PLUGIN": "ON",
        "PLASCAN_LINUX_REQUIRE_TLS_PLUGIN": "ON",
        "PLASCAN_VERIFY_LINUX_PACKAGE_RUNTIME": "ON",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/linux-vcpkg-package-release/vcpkg_installed"
      }
    },
    {
      "name": "linux-vcpkg-cuda-package-release",
      "displayName": "Linux CUDA/TensorRT DEB Release Packaging",
      "description": "Builds the Ubuntu 24.04 x86_64 package with CUDA/TensorRT LightGlue matching",
      "inherits": "linux-vcpkg-package-release",
      "binaryDir": "${sourceDir}/build/linux-vcpkg-cuda-package-release",
      "cacheVariables": {
        "PLASCAN_CUDA_ARCHITECTURES": "75;86;89;120",
        "PLASCAN_DEBIAN_ACCELERATOR_DEPENDS": "cuda-cudart-13-1, libcublas-13-1, libcusolver-13-1, libcusparse-13-1, cuda-nvrtc-13-1, libnvjitlink-13-1, libnvinfer10 (= 10.15.1.29-1+cuda13.1), libnvonnxparsers10 (= 10.15.1.29-1+cuda13.1), libnvinfer-plugin10 (= 10.15.1.29-1+cuda13.1)",
        "PLASCAN_DEBIAN_PACKAGE_VARIANT": "cuda",
        "PLASCAN_BUNDLE_BIREFNET_DYNAMIC": "ON",
        "PLASCAN_ENABLE_CUDA": "ON",
        "PLASCAN_ENABLE_TENSORRT": "ON",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/linux-vcpkg-cuda-package-release/vcpkg_installed"
      }
    },
    {
      "name": "macos-vcpkg-release",
      "displayName": "macOS Apple Silicon vcpkg Release",
      "description": "Builds the native Apple Silicon CPU configuration without CUDA, TensorRT, or OpenCL backends",
      "inherits": "vcpkg-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "Python3_EXECUTABLE": "${sourceDir}/.venv/bin/python",
        "CPACK_GENERATOR": "TGZ",
        "PLASCAN_BUNDLE_RUNTIME": "OFF",
        "PLASCAN_ENABLE_CUDA": "OFF",
        "PLASCAN_ENABLE_OPENCL": "OFF",
        "PLASCAN_ENABLE_TENSORRT": "OFF",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/macos-vcpkg-release/vcpkg_installed",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/cmake/vcpkg-overlays",
        "VCPKG_TARGET_TRIPLET": "arm64-osx"
      }
    },
    {
      "name": "macos-source-deps-release",
      "displayName": "macOS Qt 6.11.2 + OpenCV 5.0.0 + GDAL 3.12.4 source dependencies",
      "inherits": "source-deps-base",
      "binaryDir": "${sourceDir}/build/macos-source-deps-release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "PLASCAN_SOURCE_DEPENDENCY_PREFIX": "${sourceDir}/build/macos-source-deps-release/install",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/macos-source-deps-release/vcpkg_installed",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/cmake/vcpkg-overlays",
        "VCPKG_TARGET_TRIPLET": "arm64-osx"
      }
    },
    {
      "name": "macos-source-release",
      "displayName": "macOS Release with source-built Qt/OpenCV/GDAL",
      "inherits": "macos-vcpkg-release",
      "binaryDir": "${sourceDir}/build/macos-source-release",
      "environment": {
        "PROJ_DATA": "${sourceDir}/build/macos-source-deps-release/vcpkg_installed/arm64-osx/share/proj"
      },
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "${sourceDir}/build/macos-source-deps-release/install",
        "PLASCAN_REQUIRE_SOURCE_DEPENDENCIES": "ON",
        "PLASCAN_SOURCE_DEPENDENCY_PREFIX": "${sourceDir}/build/macos-source-deps-release/install",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/macos-source-deps-release/vcpkg_installed",
        "VCPKG_MANIFEST_DIR": "${sourceDir}/cmake/source-deps"
      }
    },
    {
      "name": "windows-vcpkg-debug",
      "displayName": "Windows vcpkg Debug",
      "inherits": "vcpkg-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CPACK_GENERATOR": "ZIP",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "windows-vcpkg-release",
      "displayName": "Windows vcpkg Release",
      "inherits": "vcpkg-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CPACK_GENERATOR": "ZIP",
        "PLASCAN_BUNDLE_BIREFNET_DYNAMIC": "OFF",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "windows-source-deps-release",
      "displayName": "Windows Qt 6.11.2 + OpenCV 5.0.0 + GDAL 3.12.4 source dependencies",
      "inherits": "source-deps-base",
      "binaryDir": "${sourceDir}/build/windows-source-deps-release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "environment": {
        "PATH": "${sourceDir}/build/env/sdk/tensorrt/10.15.1.29/bin;$penv{CUDA_PATH}/bin;$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PLASCAN_SOURCE_DEPENDENCY_PREFIX": "${sourceDir}/build/windows-source-deps-release/install",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/windows-source-deps-release/vcpkg_installed",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/cmake/vcpkg-overlays",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "windows-source-release",
      "displayName": "Windows Release with source-built Qt/OpenCV/GDAL",
      "inherits": "windows-vcpkg-release",
      "binaryDir": "${sourceDir}/build/windows-source-release",
      "environment": {
        "PATH": "${sourceDir}/build/env/sdk/tensorrt/10.15.1.29/bin;$penv{CUDA_PATH}/bin;${sourceDir}/build/windows-source-deps-release/install/bin;${sourceDir}/build/windows-source-deps-release/install/x64/vc17/bin;${sourceDir}/build/windows-source-deps-release/vcpkg_installed/x64-windows/bin;$penv{PATH}",
        "PROJ_DATA": "${sourceDir}/build/windows-source-deps-release/vcpkg_installed/x64-windows/share/proj"
      },
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "${sourceDir}/build/windows-source-deps-release/install",
        "PLASCAN_ENABLE_CUDA": "ON",
        "PLASCAN_ENABLE_TENSORRT": "ON",
        "PLASCAN_REQUIRE_SOURCE_DEPENDENCIES": "ON",
        "PLASCAN_SOURCE_DEPENDENCY_PREFIX": "${sourceDir}/build/windows-source-deps-release/install",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/windows-source-deps-release/vcpkg_installed",
        "VCPKG_MANIFEST_DIR": "${sourceDir}/cmake/source-deps"
      }
    },
    {
      "name": "windows-vcpkg-cuda-release",
      "displayName": "Windows vcpkg CUDA Release Packaging",
      "description": "Reuses the CUDA build initialized by scripts/build_win/build_windows_cuda.ps1",
      "inherits": "windows-vcpkg-release",
      "binaryDir": "${sourceDir}/build/windows-vcpkg-cuda-release",
      "cacheVariables": {
        "CPACK_GENERATOR": "INNOSETUP",
        "PLASCAN_BUNDLE_BIREFNET_DYNAMIC": "ON",
        "PLASCAN_BUNDLE_LOMA_R_MODELS": "ON",
        "PLASCAN_BUNDLE_ONNX_MODELS": "ON",
        "PLASCAN_BUNDLE_RUNTIME": "ON",
        "PLASCAN_CUDA_ARCHITECTURES": "75;86;89;120",
        "PLASCAN_ENABLE_CUDA": "ON",
        "PLASCAN_ENABLE_TENSORRT": "ON",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/windows-vcpkg-cuda-release/vcpkg_installed",
        "VCPKG_MANIFEST_INSTALL": "OFF"
      }
    }
  ],
