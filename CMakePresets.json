{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vcpkg-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "BUILD_TESTS": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "PLASCAN_BUNDLE_RUNTIME": "ON",
        "PLASCAN_ENABLE_CONDA": "OFF",
        "PLASCAN_ENABLE_VCPKG": "ON",
        "PLASCAN_CONDA_PREFIX": ""
      }
    },
    {
      "name": "linux-vcpkg-debug",
      "displayName": "Linux vcpkg Debug",
      "inherits": "vcpkg-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CPACK_GENERATOR": "TGZ;DEB",
        "VCPKG_TARGET_TRIPLET": "x64-linux-dynamic",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/cmake/vcpkg-overlays"
      }
    },
    {
      "name": "linux-vcpkg-release",
      "displayName": "Linux vcpkg Release",
      "inherits": "vcpkg-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CPACK_GENERATOR": "TGZ;DEB",
        "VCPKG_TARGET_TRIPLET": "x64-linux-dynamic",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/cmake/vcpkg-overlays"
      }
    },
    {
      "name": "windows-vcpkg-debug",
      "displayName": "Windows vcpkg Debug",
      "inherits": "vcpkg-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CPACK_GENERATOR": "ZIP",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "windows-vcpkg-release",
      "displayName": "Windows vcpkg Release",
      "inherits": "vcpkg-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CPACK_GENERATOR": "ZIP",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "windows-vcpkg-cuda-release",
      "displayName": "Windows vcpkg CUDA Release Packaging",
      "description": "Reuses the CUDA build initialized by scripts/build_win/build_windows_cuda.ps1",
      "inherits": "windows-vcpkg-release",
      "binaryDir": "${sourceDir}/build/windows-vcpkg-cuda-release",
      "cacheVariables": {
        "CPACK_GENERATOR": "INNOSETUP",
        "PLASCAN_BUNDLE_ONNX_MODELS": "ON",
        "PLASCAN_BUNDLE_RUNTIME": "ON",
        "PLASCAN_CUDA_ARCHITECTURES": "75;86;89;120",
        "PLASCAN_ENABLE_CUDA": "ON",
        "PLASCAN_ENABLE_TENSORRT": "ON",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/windows-vcpkg-cuda-release/vcpkg_installed",
        "VCPKG_MANIFEST_FEATURES": "opencv-dnn-cuda;ceres-cuda",
        "VCPKG_MANIFEST_INSTALL": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-vcpkg-debug",
      "configurePreset": "linux-vcpkg-debug",
      "jobs": 0
    },
    {
      "name": "linux-vcpkg-release",
      "configurePreset": "linux-vcpkg-release",
      "jobs": 0
    },
    {
      "name": "windows-vcpkg-debug",
      "configurePreset": "windows-vcpkg-debug",
      "jobs": 0
    },
    {
      "name": "windows-vcpkg-release",
      "configurePreset": "windows-vcpkg-release",
      "jobs": 0
    },
    {
      "name": "windows-vcpkg-cuda-release",
      "configurePreset": "windows-vcpkg-cuda-release",
      "jobs": 0
    },
    {
      "name": "windows-package-smoke-stage",
      "configurePreset": "windows-vcpkg-cuda-release",
      "targets": [
        "plascan_package_smoke"
      ],
      "jobs": 0
    },
    {
      "name": "windows-package-release-build",
      "configurePreset": "windows-vcpkg-cuda-release",
      "targets": [
        "plascan_gui"
      ],
      "jobs": 0
    }
  ],
  "testPresets": [
    {
      "name": "linux-vcpkg-debug",
      "configurePreset": "linux-vcpkg-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-vcpkg-release",
      "configurePreset": "linux-vcpkg-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-vcpkg-debug",
      "configurePreset": "windows-vcpkg-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-vcpkg-release",
      "configurePreset": "windows-vcpkg-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-vcpkg-cuda-release",
      "configurePreset": "windows-vcpkg-cuda-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "packagePresets": [
    {
      "name": "linux-vcpkg-debug",
      "configurePreset": "linux-vcpkg-debug",
      "generators": [
        "TGZ",
        "DEB"
      ],
      "configurations": [
        "Debug"
      ],
      "variables": {
        "CPACK_PACKAGE_DIRECTORY": "${sourceDir}/dist/packages/linux-vcpkg-debug"
      }
    },
    {
      "name": "linux-vcpkg-release",
      "configurePreset": "linux-vcpkg-release",
      "generators": [
        "TGZ",
        "DEB"
      ],
      "configurations": [
        "Release"
      ],
      "variables": {
        "CPACK_PACKAGE_DIRECTORY": "${sourceDir}/dist/packages/linux-vcpkg-release"
      }
    },
    {
      "name": "windows-vcpkg-debug",
      "configurePreset": "windows-vcpkg-debug",
      "generators": [
        "ZIP"
      ],
      "configurations": [
        "Debug"
      ],
      "variables": {
        "CPACK_PACKAGE_DIRECTORY": "${sourceDir}/dist/packages/windows-vcpkg-debug"
      }
    },
    {
      "name": "windows-vcpkg-release",
      "configurePreset": "windows-vcpkg-release",
      "generators": [
        "ZIP"
      ],
      "configurations": [
        "Release"
      ],
      "variables": {
        "CPACK_PACKAGE_DIRECTORY": "${sourceDir}/dist/packages/windows-vcpkg-release"
      }
    },
    {
      "name": "windows-package-release-cpack",
      "configurePreset": "windows-vcpkg-cuda-release",
      "generators": [
        "INNOSETUP"
      ],
      "configurations": [
        "Release"
      ],
      "variables": {
        "CPACK_PACKAGE_DIRECTORY": "${sourceDir}/build/windows-vcpkg-cuda-release/packages/release"
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "windows-package-smoke",
      "displayName": "Windows CUDA incremental package smoke",
      "description": "Incrementally builds PlaScan and updates an uncompressed runnable install tree",
      "steps": [
        {
          "type": "configure",
          "name": "windows-vcpkg-cuda-release"
        },
        {
          "type": "build",
          "name": "windows-package-smoke-stage"
        }
      ]
    },
    {
      "name": "windows-package-release",
      "displayName": "Windows CUDA full Inno Setup release",
      "description": "Incrementally builds PlaScan and creates the complete split Inno Setup installer",
      "steps": [
        {
          "type": "configure",
          "name": "windows-vcpkg-cuda-release"
        },
        {
          "type": "build",
          "name": "windows-package-release-build"
        },
        {
          "type": "package",
          "name": "windows-package-release-cpack"
        }
      ]
    }
  ]
}
