  "workflowPresets": [
    {
      "name": "linux-package-smoke",
      "displayName": "Linux incremental package smoke",
      "description": "Incrementally builds PlaScan and updates a validated uncompressed Runtime rootfs",
      "steps": [
        {
          "type": "configure",
          "name": "linux-vcpkg-package-release"
        },
        {
          "type": "build",
          "name": "linux-package-smoke-stage"
        }
      ]
    },
    {
      "name": "linux-package-deb",
      "displayName": "Linux full DEB release",
      "description": "Incrementally builds PlaScan and creates the validated Ubuntu 24.04 DEB package",
      "steps": [
        {
          "type": "configure",
          "name": "linux-vcpkg-package-release"
