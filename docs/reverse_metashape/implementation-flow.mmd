flowchart LR
  input["多视角影像与可选参考位姿"] --> feature_mode{"局部特征算法"}

  feature_mode -- "默认" --> plamatch["PlaMatch-HCT / MLDB"]
  feature_mode -- "可选" --> sift["Auto SIFT / RootSIFT"]
  feature_mode -- "模型通道" --> learned["SIFT-LightGlue / LoMa-R"]

  plamatch --> native_coarse["原生 coarse MLDB/HCT"]
  sift --> adapted_coarse["正式浮点描述子 coarse 视图"]
  learned --> adapted_coarse
  native_coarse --> pair_select["HCT + 局部一致性 + 参考预选"]
  adapted_coarse --> pair_select

  pair_select --> formal_match{"正式像对匹配"}
  plamatch --> formal_match
  sift --> formal_match
  learned --> formal_match
  formal_match --> geometry["USAC/MAGSAC 两视几何"]
  geometry --> guided{"算法支持引导重匹配?"}
  guided -- "是" --> rematch["基础矩阵引导二次匹配"]
  guided -- "否" --> tracks["多视图连接点轨迹"]
  rematch --> tracks

  tracks --> seed["初始像对评分与有限前瞻"]
  seed --> register["增量 resection / 失败重试"]
  register --> triangulate["双视/三视三角化与重三角化"]
  triangulate --> ba["局部/全局 Bundle Adjustment"]
  ba --> more{"仍有可注册影像?"}
  more -- "是" --> register
  more -- "否" --> output["已对齐相机、稀疏点云与质量报告"]

  pair_select -. "漏斗统计" .-> diagnostics["matching_funnel"]
  geometry -. "像对/内点" .-> diagnostics
  tracks -. "轨迹数" .-> diagnostics
  output -. "注册率/重投影误差" .-> diagnostics
