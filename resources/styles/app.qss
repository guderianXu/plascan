QWidget {
    background: #f4f6f8;
    color: #1f2937;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
}

QMainWindow,
QDialog {
    background: #f4f6f8;
}

QMenuBar {
    background: #f8fafc;
    border-bottom: 1px solid #d6dde7;
    padding: 2px 8px;
}

QMenuBar::item {
    background: transparent;
    padding: 5px 10px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background: #e5edf7;
}

QMenu {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    padding: 5px;
}

QMenu::item {
    padding: 6px 30px 6px 24px;
    border-radius: 4px;
}

QMenu::item:selected {
    background: #e8f1ff;
    color: #153e75;
}

QToolBar {
    background: #f8fafc;
    border-bottom: 1px solid #d6dde7;
    spacing: 4px;
    padding: 4px 6px;
}

QToolBar::separator {
    background: #d6dde7;
    width: 1px;
    margin: 4px 6px;
}

QToolBar QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px 8px;
    min-height: 24px;
}

QToolBar QToolButton:hover {
    background: #edf4fc;
    border-color: #c7d7ea;
}

QToolBar QToolButton:pressed {
    background: #dceafe;
    border-color: #8bb7ea;
}

QDockWidget::title {
    background: #f8fafc;
    border: 1px solid #d6dde7;
    padding: 4px 8px;
}

QGroupBox {
    background: #ffffff;
    border: 1px solid #d6dde7;
    border-radius: 6px;
    margin-top: 12px;
    padding: 8px 6px 6px 6px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 4px;
    color: #334155;
}

QPushButton,
QToolButton {
    background: #ffffff;
    border: 1px solid #b8c3d1;
    border-radius: 4px;
    padding: 5px 12px;
    min-height: 22px;
}

QPushButton:hover,
QToolButton:hover {
    background: #edf5ff;
    border-color: #7aa7e8;
}

QPushButton:pressed,
QToolButton:pressed,
QPushButton:checked,
QToolButton:checked {
    background: #dbeafe;
    border-color: #2563eb;
    color: #102a43;
}

QPushButton:default {
    background: #2563eb;
    border-color: #1d4ed8;
    color: #ffffff;
}

QPushButton:default:hover {
    background: #1d4ed8;
}

QPushButton:disabled,
QToolButton:disabled {
    background: #eef2f6;
    border-color: #d7dee8;
    color: #94a3b8;
}

QLineEdit,
QTextEdit,
QPlainTextEdit,
QComboBox,
QAbstractSpinBox {
    background: #ffffff;
    border: 1px solid #b8c3d1;
    border-radius: 4px;
    padding: 4px 6px;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QComboBox:focus,
QAbstractSpinBox:focus {
    border-color: #2563eb;
}

QComboBox::drop-down {
    border-left: 1px solid #d7dee8;
    width: 22px;
}

QCheckBox {
    spacing: 6px;
}

QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid #9aa8ba;
    border-radius: 3px;
    background: #ffffff;
}

QCheckBox::indicator:hover {
    border-color: #2563eb;
}

QCheckBox::indicator:checked {
    background: #2563eb;
    border-color: #1d4ed8;
    image: url(:/icons/checkmark_white.xpm);
}

QCheckBox::indicator:checked:hover {
    background: #1d4ed8;
    border-color: #1e40af;
}

QCheckBox::indicator:disabled {
    background: #eef2f7;
    border-color: #cbd5e1;
}

QCheckBox::indicator:checked:disabled {
    background: #9aa8ba;
    border-color: #8b98aa;
    image: url(:/icons/checkmark_white.xpm);
}

QTabWidget::pane {
    border: 1px solid #d6dde7;
    background: #ffffff;
}

QTabBar::tab {
    background: #e9eef5;
    border: 1px solid #d6dde7;
    border-bottom: none;
    padding: 6px 14px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background: #ffffff;
    color: #0f3b74;
    font-weight: 600;
}

QWidget#workspaceSwitchBar {
    background: #eef2f6;
    border-bottom: 1px solid #d6dde7;
}

QWidget#workspaceSwitchBar QPushButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 5px 12px;
    min-width: 56px;
    max-width: 220px;
}

QWidget#workspaceSwitchBar QPushButton:hover {
    background: #f8fafc;
    border-color: #cbd5e1;
}

QWidget#workspaceSwitchBar QPushButton:checked {
    background: #ffffff;
    border-color: #8bb7ea;
    color: #0f3b74;
    font-weight: 600;
}

QTreeView,
QTableView,
QTableWidget,
QListView,
QListWidget {
    background: #ffffff;
    alternate-background-color: #f8fafc;
    border: 1px solid #d6dde7;
    gridline-color: #e2e8f0;
}

QTreeView::item,
QListView::item,
QListWidget::item {
    min-height: 22px;
    padding: 3px 6px;
}

QTreeView::item:selected,
QListView::item:selected,
QListWidget::item:selected,
QTableView::item:selected,
QTableWidget::item:selected {
    background: #dbeafe;
    color: #102a43;
}

QFileDialog QToolButton {
    qproperty-iconSize: 24px 24px;
    min-width: 34px;
    min-height: 32px;
    padding: 4px 8px;
}

QFileDialog QPushButton,
QFileDialog QComboBox {
    qproperty-iconSize: 22px 22px;
}

QFileDialog QTreeView,
QFileDialog QListView {
    qproperty-iconSize: 24px 24px;
}

QFileDialog QTreeView::item,
QFileDialog QListView::item {
    min-height: 30px;
}

QHeaderView::section {
    background: #eef2f6;
    border: none;
    border-right: 1px solid #d6dde7;
    border-bottom: 1px solid #d6dde7;
    padding: 5px 6px;
    font-weight: 600;
}

QSplitter::handle {
    background: #d6dde7;
}

QSplitter::handle:hover {
    background: #9aa8ba;
}

QSplitter::handle:horizontal {
    width: 8px;
}

QSplitter::handle:vertical {
    height: 10px;
}

QScrollArea#parameterScrollArea,
QScrollArea#rightParameterScrollArea {
    background: transparent;
    border: none;
}

QWidget#parameterScrollWidget,
QWidget#rightParameterScrollWidget {
    background: transparent;
}

QStatusBar {
    background: #f8fafc;
    border-top: 1px solid #d6dde7;
}

QWidget#taskStatusWidget {
    background: transparent;
}

QWidget#taskStatusWidget QLabel#statusLabel {
    background: transparent;
}

QWidget#taskStatusWidget QToolButton#cancelButton {
    padding: 1px 8px;
    min-height: 18px;
}

QProgressBar {
    background: #e2e8f0;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    text-align: center;
}

QProgressBar::chunk {
    background: #2f9e74;
    border-radius: 3px;
}

QScrollBar:vertical {
    background: #eef2f6;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #aab7c7;
    border-radius: 5px;
    min-height: 28px;
    margin: 2px;
}

QScrollBar:horizontal {
    background: #eef2f6;
    height: 12px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #aab7c7;
    border-radius: 5px;
    min-width: 28px;
    margin: 2px;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0;
    height: 0;
}

QPushButton#m_refreshBtn {
    padding: 4px 10px;
}

QDialog[workflowParameterDialog="true"] QLabel,
QDialog[workflowParameterDialog="true"] QCheckBox {
    background: transparent;
}

QDialog[workflowParameterDialog="true"] QScrollArea#workflowParameterScrollArea,
QDialog[workflowParameterDialog="true"] QScrollArea#workflowParameterScrollArea QWidget#qt_scrollarea_viewport,
QDialog[workflowParameterDialog="true"] QWidget#workflowParameterContent {
    background: transparent;
    border: none;
}

QDialog[workflowParameterDialog="true"] QGroupBox {
    background: #fafbfc;
    border: 1px solid #d3d9e1;
    border-radius: 2px;
    margin-top: 10px;
    padding: 8px 6px 6px 6px;
    font-weight: 600;
}

QDialog[workflowParameterDialog="true"] QGroupBox QLabel,
QDialog[workflowParameterDialog="true"] QGroupBox QCheckBox,
QDialog[workflowParameterDialog="true"] QGroupBox QComboBox,
QDialog[workflowParameterDialog="true"] QGroupBox QAbstractSpinBox {
    font-weight: 400;
}

QDialog[workflowParameterDialog="true"] QToolButton#workflowAdvancedToggle,
QDialog[workflowParameterDialog="true"] QToolButton#workflowAdvancedToggle:checked {
    background: transparent;
    border: none;
    border-top: 1px solid #d3d9e1;
    border-bottom: 1px solid #d3d9e1;
    border-radius: 0;
    padding: 4px 2px;
    text-align: left;
}

QDialog[workflowParameterDialog="true"] QToolButton#workflowAdvancedToggle:hover {
    background: #edf2f7;
}

QDialog[workflowParameterDialog="true"] QLabel#workflowStatusLabel {
    color: #5b6674;
    padding: 2px 2px 6px 2px;
}

QDialog[workflowParameterDialog="true"] QDialogButtonBox QPushButton {
    min-width: 72px;
}
